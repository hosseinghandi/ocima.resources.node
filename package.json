{
  "name": "ocima.resource.node",
  "private": true,
  "version": "0.0.0",
  "description": "Ocima hours tracking desktop and web app",
  "author": "Ocima",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "backend": "tsx server/cli.ts",
    "backend:dev": "tsx watch server/cli.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && esbuild server/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/server.cjs && vite build",
    "build:electron": "npm run build && electron-builder --win nsis",
    "electron:dev": "concurrently -k \"npm:backend\" \"npm:dev\" \"wait-on http://127.0.0.1:3001/api/health http://127.0.0.1:5173 && electron .\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.ocima.hours",
    "productName": "Ocima Ore",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "wait-on": "^8.0.4"
  }
}
